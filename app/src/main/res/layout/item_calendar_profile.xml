<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Цвет календаря -->
        <View
            android:id="@+id/view_calendar_color"
            android:layout_width="12dp"
            android:layout_height="40dp"
            android:background="@color/colorPrimary"
            android:layout_marginEnd="16dp"/>

        <!-- Информация о календаре -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_calendar_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Название календаря"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_event_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Событий: 10"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <!-- Кнопка по умолчанию -->
        <Button
            android:id="@+id/btn_set_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="По умолчанию"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:visibility="gone"/>

        <!-- Кнопка удаления -->
        <ImageButton
            android:id="@+id/btn_delete_calendar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Удалить календарь"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>