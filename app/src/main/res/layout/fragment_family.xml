<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Состояние без семьи -->
        <LinearLayout
            android:id="@+id/no_family_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp">

            <TextView
                android:id="@+id/tv_no_family"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вы не состоите в семье"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btn_create_family"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Создать семью"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/btn_join_family"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Присоединиться к семье" />

            <Button
                android:id="@+id/btn_leave_family"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:text="Покинуть семью" />

        </LinearLayout>

        <!-- Информация о семье -->
        <LinearLayout
            android:id="@+id/family_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Заголовок семьи -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_family_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Семья"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tv_invite_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Код: XXXXXXXX"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/btn_copy_invite"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Копировать код"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_gravity="end"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Члены семьи -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Члены семьи"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/members_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"/>

            <!-- Чат -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Семейный чат"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btn_new_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Написать"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginBottom="80dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>