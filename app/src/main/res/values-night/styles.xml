<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тема -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar"> <!-- Изменили на MaterialComponents -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>

    </style>

    <!-- Стиль для CardView -->
    <style name="CardViewStyle" parent="Widget.MaterialComponents.CardView"> <!-- Изменили на MaterialComponents -->
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <!-- Стиль для кнопок -->
    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button"> <!-- Уже MaterialComponents -->
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">20dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="MaterialButtonStyle" parent="Widget.MaterialComponents.Button"> <!-- Уже MaterialComponents -->
        <item name="cornerRadius">40dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Стиль для диалогов -->
    <style name="DialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog"> <!-- Изменили на MaterialComponents -->
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="buttonBarButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <style name="DialogButtonStyle">
        <item name="android:textColor">@color/purple_500</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

</resources>